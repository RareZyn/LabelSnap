{
  "name": "labelsnap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators",
    "emulators": "firebase emulators:start --only auth,firestore --project labelsnap-12765",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project labelsnap-12765 \"vitest run --config vitest.rules.config.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "i18n:check": "node scripts/check-i18n.mjs",
    "icons": "node scripts/make-icons.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules --project labelsnap-12765"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.10.9",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "docx": "^9.0.3",
    "firebase": "^11.0.2",
    "i18next": "^23.16.8",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.0.0",
    "firebase-tools": "^13.35.1",
    "globals": "^15.12.0",
    "jszip": "^3.10.2",
    "sharp": "^0.33.5",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.5",
    "workbox-window": "^7.3.0"
  }
}
